    // --- NAVIGATION ---
    function switchPanel(id) {
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
      event.currentTarget.classList.add('active');
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      document.getElementById('panel-' + id).classList.add('active');
    }

    // --- RENDER FUNCTIONS ---
    function renderKPIs() {
      // Automatically grab the top 4 domains
      const sorted = [...DOMAINS].sort((a,b) => b.avg - a.avg);
      const top4 = sorted.slice(0, 4);
      const labels = ['الأعلى أداءً', 'مستوى متميز', 'أداء ممتاز', 'أداء جيد'];
      
      const html = top4.map((d, i) => `
        <div class="kpi">
          <div style="position:absolute; top:0; right:0; width:5px; height:100%; background:${d.color};"></div>
          <div class="kpi-val">${d.avg}%</div>
          <div class="kpi-lbl">${d.name}</div>
          <div class="kpi-sub" style="color:${d.color}">${labels[i]}</div>
        </div>
      `).join('');
      document.getElementById('kpi-row-container').innerHTML = html;
    }

    function renderTeachers() {
      const sorted = [...DOMAINS].sort((a,b) => b.avg - a.avg);
      const html = sorted.map((d) => `
        <div class="teacher-badge">
          <div class="tb-icon" style="background:${d.color}"><i class="${d.icon}"></i></div>
          <div class="tb-name">${d.teacher}</div>
          <div class="tb-domain" style="color:${d.color}">${d.name}</div>
        </div>
      `).join('');
      document.getElementById('teachers-grid-container').innerHTML = html;
    }

    function renderDomainBars() {
      const sorted = [...DOMAINS].sort((a,b) => b.avg - a.avg);
      const html = sorted.map(d => `
        <div class="domain-bar">
          <div class="domain-header"><span class="domain-name">${d.name}</span><span class="domain-pct" style="color:${d.color}">${d.avg}%</span></div>
          <div class="bar-track"><div class="bar-fill" style="width:${d.avg}%;background:${d.color}"></div></div>
        </div>
      `).join('');
      document.getElementById('domain-bars-container').innerHTML = html;
    }

    function renderValuesGrid() {
      const sorted = [...DOMAINS].sort((a,b) => b.avg - a.avg);
      const html = sorted.map(d => `
        <div class="val-chip">
          <div class="val-name">${d.name} <span style="float:right; color:${d.color}"><i class="${d.icon}"></i></span></div>
          <div class="val-row-flex">
            <div class="v-item"><div class="v-score" style="color:${d.color}">${d.avg+1}%</div><div class="v-lbl">تعاون</div><div class="v-bar-track"><div class="v-bar-fill" style="width:${d.avg+1}%;background:${d.color}"></div></div></div>
            <div class="v-item"><div class="v-score" style="color:${d.color}">${d.avg}%</div><div class="v-lbl">أمانة</div><div class="v-bar-track"><div class="v-bar-fill" style="width:${d.avg}%;background:${d.color}"></div></div></div>
            <div class="v-item"><div class="v-score" style="color:${d.color}">${d.avg-1}%</div><div class="v-lbl">عزيمة</div><div class="v-bar-track"><div class="v-bar-fill" style="width:${d.avg-1}%;background:${d.color}"></div></div></div>
            <div class="v-item"><div class="v-score" style="color:${d.color}">${d.avg+1}%</div><div class="v-lbl">انضباط</div><div class="v-bar-track"><div class="v-bar-fill" style="width:${d.avg+1}%;background:${d.color}"></div></div></div>
          </div>
        </div>
      `).join('');
      document.getElementById('values-grid-container').innerHTML = html;
    }

    function renderDetailedDomains() {
      const sorted = [...DOMAINS].sort((a,b) => b.avg - a.avg);
      const html = sorted.map(d => {
        const g1 = STUDENTS.filter(s => s.domain === d.name && s.group === 'المجموعة 1');
        const g2 = STUDENTS.filter(s => s.domain === d.name && s.group === 'المجموعة 2');
        
        const buildTbl = (arr) => arr.map(s => `
          <tr>
            <td>${s.name}</td>
            <td><span class="role-badge" style="background:${ROLES[s.role].bg};color:${ROLES[s.role].tx}">${s.role}</span></td>
            <td><span class="score-pill" style="color:${d.color};background:rgba(255,255,255,0.7)">${s.t}%</span></td>
          </tr>
        `).join('');

        return `
          <div class="domain-section">
            <div class="ds-header" style="background:${d.color}">
              <div><div class="ds-name"><i class="${d.icon}" style="margin-left:5px"></i> ${d.name}</div><div class="ds-teacher">${d.teacher}</div></div>
              <div class="ds-avg">${d.avg}%</div>
            </div>
            <div class="groups-wrap">
              <div class="group-col">
                <span class="group-label" style="background:var(--emerald)">المجموعة الأولى</span>
                <table class="inner-tbl"><thead><tr><th>اسم الطالبة</th><th>الوظيفة</th><th>النسبة</th></tr></thead><tbody>${buildTbl(g1)}</tbody></table>
              </div>
              <div class="group-col">
                <span class="group-label" style="background:var(--sky)">المجموعة الثانية</span>
                <table class="inner-tbl"><thead><tr><th>اسم الطالبة</th><th>الوظيفة</th><th>النسبة</th></tr></thead><tbody>${buildTbl(g2)}</tbody></table>
              </div>
            </div>
          </div>
        `;
      }).join('');
      document.getElementById('domains-detailed-container').innerHTML = html;
    }

    function renderTimeline() {
      const html = TIMELINE.map((t, i) => `
        <div class="timeline-item">
          <div class="tl-icon" style="background:${t.color}">${i+1}</div>
          <div class="tl-body">
            <div class="tl-week">${t.week}</div>
            <div class="tl-stage">${t.stage}</div>
            <div class="tl-bar"><div class="tl-prog" style="width:${t.pct}%;background:${t.color}"></div></div>
            <div class="tl-pct"><span style="color:${t.color}">${t.pct}%</span> <span class="badge ${t.cls}">${t.status}</span></div>
          </div>
        </div>
      `).join('');
      document.getElementById('timeline-container').innerHTML = html;
    }

    function initFilters() {
      const sel = document.getElementById('filterDomain');
      const sorted = [...DOMAINS].sort((a,b) => b.avg - a.avg);
      sorted.forEach(d => {
        const o = document.createElement('option'); o.value = d.name; o.textContent = d.name; sel.appendChild(o);
      });
    }

    function renderMainTable() {
      const dFilter = document.getElementById('filterDomain').value;
      const gFilter = document.getElementById('filterGroup').value;
      let data = STUDENTS;
      if (dFilter) data = data.filter(s => s.domain === dFilter);
      if (gFilter) data = data.filter(s => s.group === gFilter);

      const html = data.map((s, i) => `
        <tr>
          <td style="color:#B0BEC5">${i+1}</td>
          <td style="color:var(--navy)">${s.name}</td>
          <td style="color:var(--text-muted)">${s.domain}</td>
          <td style="color:var(--text-muted)">${s.group}</td>
          <td><span class="role-badge" style="background:${ROLES[s.role].bg};color:${ROLES[s.role].tx}">${s.role}</span></td>
          <td class="pct-cell">${s.c}%</td>
          <td class="pct-cell">${s.h}%</td>
          <td class="pct-cell">${s.d}%</td>
          <td class="pct-cell">${s.i}%</td>
          <td class="pct-cell" style="color:var(--teal)">${s.t}%</td>
        </tr>
      `).join('');
      document.getElementById('main-table-body').innerHTML = html;
    }

    function initCharts() {
      const sorted = [...DOMAINS].sort((a,b) => b.avg - a.avg);
      
      // Group Bar Chart
      new Chart(document.getElementById('groupChart'), {
        type: 'bar',
        data: {
          labels: sorted.map(d => d.name.split(' ')[0]),
          datasets: [
            { label: 'المجموعة الأولى', data: sorted.map(d => d.g1), backgroundColor: '#07A869', borderRadius: 4 },
            { label: 'المجموعة الثانية', data: sorted.map(d => d.g2), backgroundColor: '#3D7EB9', borderRadius: 4 }
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { min: 80, max: 100 }, x: { grid: { display: false }, ticks: {font: {family: 'Tajawal', weight: 'bold'}} } }
        }
      });

      // Radar Chart (Average roughly around 92.5 for visualization)
      new Chart(document.getElementById('radarChart'), {
        type: 'radar',
        data: {
          labels: ['التعاون', 'الأمانة', 'العزيمة', 'الانضباط'],
          datasets: [{
            data: [93.1, 91.8, 92.5, 93.0],
            backgroundColor: 'rgba(13,169,166,0.15)', borderColor: '#0DA9A6', borderWidth: 2.5, pointBackgroundColor: '#0DA9A6', pointRadius: 4
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { r: { min: 80, max: 100, pointLabels: { font: { family: 'Tajawal', size: 12, weight: 'bold' } } } }
        }
      });
    }

    // --- BOOT ---
    document.addEventListener('DOMContentLoaded', () => {
      renderKPIs();
      renderTeachers();
      renderTimeline();
      renderDomainBars();
      renderValuesGrid();
      renderDetailedDomains();
      initFilters();
      renderMainTable();
      setTimeout(initCharts, 100);
    });
  </script>
</body>
